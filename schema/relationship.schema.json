{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poweratlas.example/schema/relationship.schema.json",
  "title": "Power Atlas Relationship",
  "type": "object",
  "required": [
    "id",
    "source_id",
    "target_id",
    "type",
    "label",
    "evidence_grade",
    "sources"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "source_id": { "type": "string", "minLength": 1 },
    "target_id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": [
        "family",
        "marriage",
        "employment",
        "ownership",
        "board",
        "funding",
        "donation",
        "appointment",
        "advisory",
        "business-partnership",
        "underwriting",
        "political-support",
        "membership",
        "education",
        "legal-representation",
        "government-contract",
        "other"
      ]
    },
    "label": { "type": "string", "minLength": 1 },
    "direction": {
      "type": "string",
      "enum": ["source-to-target", "target-to-source", "bidirectional", "undirected"]
    },
    "start_date": { "type": ["string", "null"] },
    "end_date": { "type": ["string", "null"] },
    "date_precision": {
      "type": "string",
      "enum": ["day", "month", "year", "range", "approximate", "unknown"]
    },
    "place": { "type": ["string", "null"] },
    "summary": { "type": "string" },
    "does_not_establish": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_grade": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "E"]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "canonical": { "type": "boolean", "default": false },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url", "source_type"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string" },
          "source_type": {
            "type": "string",
            "enum": ["primary", "scholarly", "journalistic", "database", "archive", "other"]
          },
          "publisher": { "type": ["string", "null"] },
          "publication_date": { "type": ["string", "null"] },
          "locator": { "type": ["string", "null"] },
          "archived_url": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "contributor": { "type": ["string", "null"] },
        "reviewer": { "type": ["string", "null"] },
        "ai_assisted": { "type": "boolean", "default": false },
        "import_source": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
